ALTER TABLE mangas ADD COLUMN uuid TEXT;

-- Backfill UUIDs for existing manga rows that don't have one.
-- Using a CTE to generate deterministic-ish UUIDs per row id via
-- randomblob() since SQLite has no native UUID function.
UPDATE mangas
SET uuid = lower(
    hex(randomblob(4)) || '-' ||
    hex(randomblob(2)) || '-' ||
    '4' || substr(hex(randomblob(2)), 2) || '-' ||
    substr('89ab', abs(random()) % 4 + 1, 1) || substr(hex(randomblob(2)), 2) || '-' ||
    hex(randomblob(6))
)
WHERE uuid IS NULL;
