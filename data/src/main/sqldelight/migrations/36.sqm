CREATE TABLE IF NOT EXISTS reading_order(
    _id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    description TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE IF NOT EXISTS reading_order_node(
    _id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id INTEGER NOT NULL,
    manga_id INTEGER NOT NULL,
    position INTEGER NOT NULL DEFAULT 0,
    UNIQUE(order_id, manga_id),
    FOREIGN KEY(order_id) REFERENCES reading_order(_id) ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES mangas(_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS reading_order_edge(
    _id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id INTEGER NOT NULL,
    from_manga_id INTEGER NOT NULL,
    to_manga_id INTEGER NOT NULL,
    UNIQUE(order_id, from_manga_id, to_manga_id),
    FOREIGN KEY(order_id) REFERENCES reading_order(_id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS reading_order_progress(
    order_id INTEGER NOT NULL,
    manga_id INTEGER NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    completed_at INTEGER,
    PRIMARY KEY (order_id, manga_id),
    FOREIGN KEY(order_id) REFERENCES reading_order(_id) ON DELETE CASCADE
);
