CREATE TABLE reading_order_progress(
    order_id INTEGER NOT NULL,
    entry_id INTEGER NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    completed_at INTEGER,
    PRIMARY KEY (order_id, entry_id),
    FOREIGN KEY(order_id) REFERENCES reading_order(_id) ON DELETE CASCADE
);

getProgress:
SELECT completed, completed_at
FROM reading_order_progress
WHERE order_id = :orderId AND entry_id = :entryId;

getAllProgressByOrderId:
SELECT entry_id, completed, completed_at
FROM reading_order_progress
WHERE order_id = :orderId;

upsertProgress:
INSERT INTO reading_order_progress(order_id, entry_id, completed, completed_at)
VALUES (:orderId, :entryId, :completed, :completedAt)
ON CONFLICT(order_id, entry_id) DO UPDATE SET
    completed = excluded.completed,
    completed_at = excluded.completed_at;

deleteProgressByOrderId:
DELETE FROM reading_order_progress
WHERE order_id = :orderId;

deleteProgressByEntryId:
DELETE FROM reading_order_progress
WHERE order_id = :orderId AND entry_id = :entryId;
