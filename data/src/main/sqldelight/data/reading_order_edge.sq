CREATE TABLE reading_order_edge(
    _id INTEGER PRIMARY KEY AUTOINCREMENT,
    order_id INTEGER NOT NULL,
    from_manga_id INTEGER NOT NULL,
    to_manga_id INTEGER NOT NULL,
    UNIQUE(order_id, from_manga_id, to_manga_id),
    FOREIGN KEY(order_id) REFERENCES reading_order(_id) ON DELETE CASCADE
);

getEdgesByOrderId:
SELECT _id AS id, order_id, from_manga_id, to_manga_id
FROM reading_order_edge
WHERE order_id = :orderId;

getEdgesFromManga:
SELECT _id AS id, order_id, from_manga_id, to_manga_id
FROM reading_order_edge
WHERE order_id = :orderId AND from_manga_id = :mangaId;

getEdgesToManga:
SELECT _id AS id, order_id, from_manga_id, to_manga_id
FROM reading_order_edge
WHERE order_id = :orderId AND to_manga_id = :mangaId;

insertEdge:
INSERT INTO reading_order_edge(order_id, from_manga_id, to_manga_id)
VALUES (:orderId, :fromMangaId, :toMangaId)
ON CONFLICT(order_id, from_manga_id, to_manga_id) DO NOTHING;

deleteEdge:
DELETE FROM reading_order_edge
WHERE order_id = :orderId AND from_manga_id = :fromMangaId AND to_manga_id = :toMangaId;

deleteEdgesByOrderId:
DELETE FROM reading_order_edge
WHERE order_id = :orderId;

deleteEdgesByMangaId:
DELETE FROM reading_order_edge
WHERE order_id = :orderId AND (from_manga_id = :mangaId OR to_manga_id = :mangaId);

countPrerequisites:
SELECT COUNT(*) FROM reading_order_edge
WHERE order_id = :orderId AND to_manga_id = :mangaId;

getPrerequisites:
SELECT from_manga_id FROM reading_order_edge
WHERE order_id = :orderId AND to_manga_id = :mangaId;
