-- Canonical per-volume metadata + chapter->volume boundary cache
-- (NCM-016 / Phase 21). Mirrors the worker's work_volumes /
-- work_volume_chapters rows for one canonical work; populated lazily by
-- CanonicalVolumes on first detail-view visit and reused offline.

CREATE TABLE canonical_volumes(
    work_id TEXT NOT NULL,
    volume_no REAL NOT NULL,
    language TEXT NOT NULL,
    cover_url TEXT,
    cover_thumb_url TEXT,
    cover_blurhash TEXT,
    isbn TEXT,
    release_date TEXT,
    pages INTEGER,
    source TEXT,
    PRIMARY KEY(work_id, volume_no, language)
);

CREATE TABLE canonical_volume_map(
    work_id TEXT NOT NULL,
    chapter REAL NOT NULL,
    volume_no REAL NOT NULL,
    confidence REAL NOT NULL,
    scheme TEXT,
    sources TEXT NOT NULL DEFAULT '[]',
    PRIMARY KEY(work_id, chapter)
);

-- One row per fetched work — presence is the "we asked already" marker,
-- so a worker miss doesn't re-request on every screen open.
CREATE TABLE canonical_volume_meta(
    work_id TEXT NOT NULL PRIMARY KEY,
    boundary_confidence REAL,
    final_volume REAL,
    covers_count INTEGER NOT NULL DEFAULT 0,
    fetched_at INTEGER NOT NULL
);

volumesForWork:
SELECT * FROM canonical_volumes
WHERE work_id = :workId
ORDER BY volume_no ASC, language ASC;

boundariesForWork:
SELECT chapter, volume_no, confidence, scheme, sources
FROM canonical_volume_map
WHERE work_id = :workId
ORDER BY chapter ASC;

metaForWork:
SELECT * FROM canonical_volume_meta
WHERE work_id = :workId;

deleteWorkVolumes:
DELETE FROM canonical_volumes WHERE work_id = :workId;

deleteWorkBoundaries:
DELETE FROM canonical_volume_map WHERE work_id = :workId;

insertVolume:
INSERT OR REPLACE INTO canonical_volumes(
    work_id, volume_no, language, cover_url, cover_thumb_url,
    cover_blurhash, isbn, release_date, pages, source
) VALUES (
    :workId, :volumeNo, :language, :coverUrl, :coverThumbUrl,
    :coverBlurhash, :isbn, :releaseDate, :pages, :source
);

insertBoundary:
INSERT OR REPLACE INTO canonical_volume_map(
    work_id, chapter, volume_no, confidence, scheme, sources
) VALUES (
    :workId, :chapter, :volumeNo, :confidence, :scheme, :sources
);

upsertMeta:
INSERT OR REPLACE INTO canonical_volume_meta(
    work_id, boundary_confidence, final_volume, covers_count, fetched_at
) VALUES (
    :workId, :boundaryConfidence, :finalVolume, :coversCount, :fetchedAt
);
